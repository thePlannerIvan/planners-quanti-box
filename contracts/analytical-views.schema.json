{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantiBox analytical views",
  "type": "object",
  "required": ["schema_version", "views"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["view_id", "relation_id", "decision_question", "operation", "status", "reason"],
        "properties": {
          "view_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "relation_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "decision_question": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "expected_relation": { "type": "string" },
          "status": { "enum": ["keep", "appendix", "reject"] },
          "reason": { "type": "string", "minLength": 1 },
          "preferred_chart_family": { "type": "string" },
          "omission_reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
