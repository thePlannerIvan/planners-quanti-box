{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantiBox normalized dataset bundle manifest",
  "type": "object",
  "required": ["schema_version", "source_snapshot_sha256", "tables"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["table_id", "path", "sha256", "row_count", "observation_unit"],
        "properties": {
          "table_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "row_count": { "type": "integer", "minimum": 0 },
          "observation_unit": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
