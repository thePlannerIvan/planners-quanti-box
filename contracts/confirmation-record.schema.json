{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantiBox CP0 approval binding v3",
  "type": "object",
  "required": ["schema_version", "status", "proposal_sha256", "data_snapshot_sha256", "confirmed_at", "user_confirmation"],
  "properties": {
    "schema_version": { "const": "3.0" },
    "status": { "const": "approved" },
    "proposal_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "data_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "confirmed_at": { "type": "string", "format": "date-time" },
    "user_confirmation": {
      "type": "object",
      "required": ["decision", "verbatim"],
      "properties": {
        "decision": { "const": "approve" },
        "verbatim": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
