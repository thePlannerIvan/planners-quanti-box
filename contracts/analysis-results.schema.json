{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantiBox analysis results v3",
  "type": "object",
  "required": ["schema_version", "input", "results"],
  "properties": {
    "schema_version": { "const": "3.0" },
    "input": {
      "type": "object",
      "required": ["data_snapshot_sha256", "execution_brief_sha256", "transformation_version"],
      "properties": {
        "data_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "execution_brief_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dataset_manifest_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "transformation_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["contract_id", "kind", "value"],
        "properties": {
          "contract_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "kind": { "enum": ["scalar", "series"] },
          "value": {},
          "provenance": { "type": "string" }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "scalar" } } }, "then": { "properties": { "value": { "type": ["number", "string", "boolean"] } } } },
          { "if": { "properties": { "kind": { "const": "series" } } }, "then": { "properties": { "value": { "type": "array", "minItems": 1 } } } }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
