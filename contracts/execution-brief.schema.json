{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantiBox execution brief v3",
  "type": "object",
  "required": ["schema_version", "tier", "context", "evidence_viability", "method_plan"],
  "properties": {
    "schema_version": { "const": "3.0" },
    "tier": { "enum": ["quick", "standard", "deep"] },
    "context": {
      "type": "object",
      "required": ["context_id", "decision_to_make", "context_status", "context_gaps"],
      "properties": {
        "context_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
        "decision_owner": { "type": ["string", "null"] },
        "decision_to_make": { "type": "string", "minLength": 1 },
        "current_strategy_or_hypothesis": { "type": ["string", "null"] },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "success_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "context_status": { "enum": ["confirmed", "partial", "unknown"] },
        "context_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "evidence_viability": {
      "type": "object",
      "required": ["status", "decision_impact", "checks", "recommended_route"],
      "properties": {
        "status": { "enum": ["viable", "conditional", "fatal"] },
        "decision_impact": { "type": "string", "minLength": 1 },
        "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "recommended_route": { "enum": ["proceed", "narrow", "stop-and-request-data", "separate-optional-task"] },
        "fatal_override_approved": { "type": "boolean" },
        "redefined_question": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "method_plan": {
      "type": "object",
      "required": ["decision_question", "decision_recipe", "primary_method", "secondary_methods", "steps", "expected_outputs", "quality_gates", "boundaries", "planned_relations", "metric_contracts"],
      "properties": {
        "decision_question": { "type": "string", "minLength": 1 },
        "decision_recipe": { "type": ["string", "null"] },
        "primary_method": { "type": "string", "minLength": 1 },
        "secondary_methods": { "type": "array", "maxItems": 1, "items": { "type": "string", "minLength": 1 } },
        "planned_relations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "metric_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["contract_id", "observation_unit", "definition", "allowed_uses", "forbidden_uses"],
            "properties": {
              "contract_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
              "observation_unit": { "type": "string", "minLength": 1 },
              "definition": { "type": "string", "minLength": 1 },
              "denominator": { "type": ["string", "null"] },
              "time_window": { "type": ["string", "null"] },
              "allowed_uses": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "forbidden_uses": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            },
            "additionalProperties": false
          }
        },
        "steps": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "expected_outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "quality_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
