{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantiBox findings ledger v3",
  "type": "object",
  "required": ["schema_version", "context_id", "findings"],
  "properties": {
    "schema_version": { "const": "3.0" },
    "context_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["finding_id", "type", "title", "text", "result_refs", "evidence_level", "robustness_status", "limitations"],
        "properties": {
          "finding_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "type": { "enum": ["fact", "interpretation", "hypothesis"] },
          "title": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "result_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" } },
          "evidence_level": { "enum": ["descriptive", "comparative", "associational", "inferential", "causal"] },
          "robustness_status": { "enum": ["passed", "conditional", "failed"] },
          "source": { "type": "string" },
          "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
